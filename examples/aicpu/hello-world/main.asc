#include "acl/acl.h"
#include <cstdio>

struct KernelArgs {
    int mode;
};

extern __global__ __aicpu__ uint32_t hello_world(void *args);

// The kernel launch itself is asynchronous, so a kernel that fails to load or
// run reports through aclrtSynchronizeStream. Without checking it, this example
// exits 0 and prints nothing, which looks like printf not working.
#define ACL_CHECK(expr)                                                        \
    do {                                                                       \
        aclError err = (expr);                                                 \
        if (err != ACL_SUCCESS) {                                              \
            std::fprintf(stderr, "%s:%d: %s failed with %d\n", __FILE__,       \
                         __LINE__, #expr, err);                               \
            return 1;                                                          \
        }                                                                      \
    } while (0)

int32_t main(int argc, char const *argv[])
{
    ACL_CHECK(aclInit(nullptr));
    int32_t deviceId = 0;
    ACL_CHECK(aclrtSetDevice(deviceId));
    aclrtStream stream = nullptr;
    ACL_CHECK(aclrtCreateStream(&stream));

    struct KernelArgs args = {1};
    constexpr uint32_t numBlocks = 1;
    hello_world<<<numBlocks, nullptr, stream>>>(&args, sizeof(KernelArgs));
    ACL_CHECK(aclrtSynchronizeStream(stream));

    ACL_CHECK(aclrtDestroyStream(stream));
    ACL_CHECK(aclrtResetDevice(deviceId));
    ACL_CHECK(aclFinalize());
    return 0;
}
