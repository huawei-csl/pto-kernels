// Fast Walsh-Hadamard transform (VMI raw .pto), N=2048, CCE-PARITY kernel:
// MULTI-CORE + 4-buffer deep pipeline (prefetch depth 2), 32KB UB
// tiles, TILE LOOP UNROLLED (immediate addressing = the CCE-parity fix). fp16,
// in-place y = x @ H (unnormalized). AUTO-GENERATED by gen_had_full.py.
// PER-N LAYOUT: R(pack)=1 chunks=8 rot=0 group=2048
//   plain=11 log2N=11 lanes=128 (packing N<256 / chunking N>256).
// Reproduces CCE (DEF_BUFFERS=4, DEF_PREFETCH=2, TILE_BYTES=32768=32KB,
// block_dim=G). GRID-AGNOSTIC multi-core: block b streams row band [b*rpb,(b+1)*rpb)
// (rpb=batch/G) in CR=8-row chunks (CHUNK=16384 elems) through a 4-buffer
// UB ring, unrolled-by-4. TILES=8/chunk, 8 units/tile (UNITS=1).
// REQUIRES batch % (G*32) == 0. batch_hint=256 (annotation only).
module attributes {
  pto.target_arch = "a5",
  pto.kernel_kind = #pto.kernel_kind<vector>
} {
  func.func @fast_hadamard_vmi_full_n2048(
      %x: !pto.ptr<f16, gm>, %batch: i32, %n: i32, %log2n: i32)
      attributes {pto.kernel} {
    %c0 = arith.constant 0 : index
    %c1 = arith.constant 1 : index
    %c2 = arith.constant 2 : index
    %c3 = arith.constant 3 : index
    %c4 = arith.constant 4 : index
    %c5 = arith.constant 5 : index
    %c0_i64 = arith.constant 0 : i64
    %clen_i64 = arith.constant 4096 : i64
    %c128_i32 = arith.constant 128 : i32
    %cr_idx = arith.constant 8 : index
    %n_idx = arith.constant 2048 : index
    %crn_idx = arith.constant 16384 : index
    %rows_i64 = arith.constant 8 : i64
    %buf0_i64 = arith.constant 0 : i64
    %buf1_i64 = arith.constant 32768 : i64
    %buf2_i64 = arith.constant 65536 : i64
    %buf3_i64 = arith.constant 98304 : i64
    %ubuf0 = pto.castptr %buf0_i64 : i64 -> !pto.ptr<f16, ub>
    %ubuf1 = pto.castptr %buf1_i64 : i64 -> !pto.ptr<f16, ub>
    %ubuf2 = pto.castptr %buf2_i64 : i64 -> !pto.ptr<f16, ub>
    %ubuf3 = pto.castptr %buf3_i64 : i64 -> !pto.ptr<f16, ub>

    // ---- runtime block geometry (a5 multi-core idiom, PA split-KV style) ----
    %bidx_i64 = pto.get_block_idx
    %gnum_i64 = pto.get_block_num
    %bidx = arith.index_cast %bidx_i64 : i64 to index
    %gnum = arith.index_cast %gnum_i64 : i64 to index
    %batch_idx = arith.index_cast %batch : i32 to index

    // rpb = batch / G   (REQUIRES batch % (G*32) == 0)
    %rpb = arith.divui %batch_idx, %gnum : index
    // nchunk_block = rpb / CR   (multiple of 4)
    %nchunk = arith.divui %rpb, %cr_idx : index
    // nquad = nchunk_block / 4 ; steady-state trip = nquad - 1
    %nquad = arith.divui %nchunk, %c4 : index
    %trip = arith.subi %nquad, %c1 : index
    // block base (elements) = bidx * rpb * N
    %brow = arith.muli %bidx, %rpb : index
    %bbase = arith.muli %brow, %n_idx : index
    // epilogue chunk indices (last 4 chunks of the block)
    %nchunk_m1 = arith.subi %nchunk, %c1 : index
    %nchunk_m2 = arith.subi %nchunk, %c2 : index
    %nchunk_m3 = arith.subi %nchunk, %c3 : index
    %nchunk_m4 = arith.subi %nchunk, %c4 : index

    // ---- prologue: mark all 4 buffers free, prefetch chunk0->buf0, chunk1->buf1 ----
    pto.set_flag["PIPE_MTE3", "PIPE_MTE2", "EVENT_ID0"]
    pto.set_flag["PIPE_MTE3", "PIPE_MTE2", "EVENT_ID1"]
    pto.set_flag["PIPE_MTE3", "PIPE_MTE2", "EVENT_ID2"]
    pto.set_flag["PIPE_MTE3", "PIPE_MTE2", "EVENT_ID3"]
    // gx for prologue chunks 0 and 1
    %pg0 = pto.addptr %x, %bbase : !pto.ptr<f16, gm> -> !pto.ptr<f16, gm>
    %p1off = arith.constant 16384 : index
    %p1base = arith.addi %bbase, %p1off : index
    %pg1 = pto.addptr %x, %p1base : !pto.ptr<f16, gm> -> !pto.ptr<f16, gm>
    pto.wait_flag["PIPE_MTE3", "PIPE_MTE2", "EVENT_ID0"]
    pto.mte_gm_ub %pg0, %ubuf0, %c0_i64, %clen_i64
      nburst(%rows_i64, %clen_i64, %clen_i64)
      : !pto.ptr<f16, gm>, !pto.ptr<f16, ub>, i64, i64, i64, i64, i64
    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
    pto.wait_flag["PIPE_MTE3", "PIPE_MTE2", "EVENT_ID1"]
    pto.mte_gm_ub %pg1, %ubuf1, %c0_i64, %clen_i64
      nburst(%rows_i64, %clen_i64, %clen_i64)
      : !pto.ptr<f16, gm>, !pto.ptr<f16, ub>, i64, i64, i64, i64, i64
    pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID1"]

    // ---- steady state: nquad-1 quads, each processes chunks 4q..4q+3 ----
    scf.for %q = %c0 to %trip step %c1 {
      %q4 = arith.muli %q, %c4 : index
      %q4p1 = arith.addi %q4, %c1 : index
      %q4p2 = arith.addi %q4, %c2 : index
      %q4p3 = arith.addi %q4, %c3 : index
      %q4p4 = arith.addi %q4, %c4 : index
      %q4p5 = arith.addi %q4, %c5 : index
      %coff_b0c = arith.muli %q4, %crn_idx : index
      %cbase_b0c = arith.addi %bbase, %coff_b0c : index
      %gx_b0c = pto.addptr %x, %cbase_b0c : !pto.ptr<f16, gm> -> !pto.ptr<f16, gm>
      %coff_b0f = arith.muli %q4p2, %crn_idx : index
      %cbase_b0f = arith.addi %bbase, %coff_b0f : index
      %gx_b0f = pto.addptr %x, %cbase_b0f : !pto.ptr<f16, gm> -> !pto.ptr<f16, gm>
      // prefetch chunk into buf2 (overlaps compute of buf0)
      pto.wait_flag["PIPE_MTE3", "PIPE_MTE2", "EVENT_ID2"]
      pto.mte_gm_ub %gx_b0f, %ubuf2, %c0_i64, %clen_i64
        nburst(%rows_i64, %clen_i64, %clen_i64)
        : !pto.ptr<f16, gm>, !pto.ptr<f16, ub>, i64, i64, i64, i64, i64
      pto.set_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID2"]
      pto.wait_flag["PIPE_MTE2", "PIPE_V", "EVENT_ID0"]
      pto.vecscope {
        %mask_b0c, %so_b0c = pto.plt_b16 %c128_i32 : i32 -> !pto.mask<b16>, i32
        %cP_b0c = arith.constant 11 : index
        scf.for %stage_b0c = %c0 to %cP_b0c step %c1 {
          %e1_b0c = arith.constant 0 : index
          %e2_b0c = arith.constant 128 : index
          %e3_b0c = arith.constant 256 : index
          %e4_b0c = arith.constant 384 : index
          %e5_b0c = arith.constant 512 : index
          %e6_b0c = arith.constant 640 : index
          %e7_b0c = arith.constant 768 : index
          %e8_b0c = arith.constant 896 : index
          %e9_b0c = arith.constant 1024 : index
          %e10_b0c = arith.constant 1152 : index
          %e11_b0c = arith.constant 1280 : index
          %e12_b0c = arith.constant 1408 : index
          %e13_b0c = arith.constant 1536 : index
          %e14_b0c = arith.constant 1664 : index
          %e15_b0c = arith.constant 1792 : index
          %e16_b0c = arith.constant 1920 : index
          %tbb_b0c_0 = arith.constant 0 : i64
          %ub_b0c_0 = pto.castptr %tbb_b0c_0 : i64 -> !pto.ptr<f16, ub>
          %v17, %v25 = pto.vldsx2 %ub_b0c_0[%e1_b0c], "DINTLV_B16"
              : !pto.ptr<f16, ub>, index -> !pto.vreg<128xf16>, !pto.vreg<128xf16>
          %v18, %v26 = pto.vldsx2 %ub_b0c_0[%e3_b0c], "DINTLV_B16"
              : !pto.ptr<f16, ub>, index -> !pto.vreg<128xf16>, !pto.vreg<128xf16>
          %v19, %v27 = pto.vldsx2 %ub_b0c_0[%e5_b0c], "DINTLV_B16"
              : !pto.ptr<f16, ub>, index -> !pto.vreg<128xf16>, !pto.vreg<128xf16>
          %v20, %v28 = pto.vldsx2 %ub_b0c_0[%e7_b0c], "DINTLV_B16"
              : !pto.ptr<f16, ub>, index -> !pto.vreg<128xf16>, !pto.vreg<128xf16>
          %v21, %v29 = pto.vldsx2 %ub_b0c_0[%e9_b0c], "DINTLV_B16"
              : !pto.ptr<f16, ub>, index -> !pto.vreg<128xf16>, !pto.vreg<128xf16>
          %v22, %v30 = pto.vldsx2 %ub_b0c_0[%e11_b0c], "DINTLV_B16"
              : !pto.ptr<f16, ub>, index -> !pto.vreg<128xf16>, !pto.vreg<128xf16>
          %v23, %v31 = pto.vldsx2 %ub_b0c_0[%e13_b0c], "DINTLV_B16"
              : !pto.ptr<f16, ub>, index -> !pto.vreg<128xf16>, !pto.vreg<128xf16>
          %v24, %v32 = pto.vldsx2 %ub_b0c_0[%e15_b0c], "DINTLV_B16"
              : !pto.ptr<f16, ub>, index -> !pto.vreg<128xf16>, !pto.vreg<128xf16>
          %v33 = pto.vadd %v17, %v25, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v34 = pto.vadd %v18, %v26, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v35 = pto.vadd %v19, %v27, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v36 = pto.vadd %v20, %v28, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v37 = pto.vadd %v21, %v29, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v38 = pto.vadd %v22, %v30, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v39 = pto.vadd %v23, %v31, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v40 = pto.vadd %v24, %v32, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v41 = pto.vsub %v17, %v25, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v42 = pto.vsub %v18, %v26, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v43 = pto.vsub %v19, %v27, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v44 = pto.vsub %v20, %v28, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v45 = pto.vsub %v21, %v29, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v46 = pto.vsub %v22, %v30, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v47 = pto.vsub %v23, %v31, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v48 = pto.vsub %v24, %v32, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          pto.vsts %v33, %ub_b0c_0[%e1_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          pto.vsts %v34, %ub_b0c_0[%e2_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          pto.vsts %v35, %ub_b0c_0[%e3_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          pto.vsts %v36, %ub_b0c_0[%e4_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          pto.vsts %v37, %ub_b0c_0[%e5_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          pto.vsts %v38, %ub_b0c_0[%e6_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          pto.vsts %v39, %ub_b0c_0[%e7_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          pto.vsts %v40, %ub_b0c_0[%e8_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          pto.vsts %v41, %ub_b0c_0[%e9_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          pto.vsts %v42, %ub_b0c_0[%e10_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          pto.vsts %v43, %ub_b0c_0[%e11_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          pto.vsts %v44, %ub_b0c_0[%e12_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          pto.vsts %v45, %ub_b0c_0[%e13_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          pto.vsts %v46, %ub_b0c_0[%e14_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          pto.vsts %v47, %ub_b0c_0[%e15_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          pto.vsts %v48, %ub_b0c_0[%e16_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          %tbb_b0c_1 = arith.constant 4096 : i64
          %ub_b0c_1 = pto.castptr %tbb_b0c_1 : i64 -> !pto.ptr<f16, ub>
          %v49, %v57 = pto.vldsx2 %ub_b0c_1[%e1_b0c], "DINTLV_B16"
              : !pto.ptr<f16, ub>, index -> !pto.vreg<128xf16>, !pto.vreg<128xf16>
          %v50, %v58 = pto.vldsx2 %ub_b0c_1[%e3_b0c], "DINTLV_B16"
              : !pto.ptr<f16, ub>, index -> !pto.vreg<128xf16>, !pto.vreg<128xf16>
          %v51, %v59 = pto.vldsx2 %ub_b0c_1[%e5_b0c], "DINTLV_B16"
              : !pto.ptr<f16, ub>, index -> !pto.vreg<128xf16>, !pto.vreg<128xf16>
          %v52, %v60 = pto.vldsx2 %ub_b0c_1[%e7_b0c], "DINTLV_B16"
              : !pto.ptr<f16, ub>, index -> !pto.vreg<128xf16>, !pto.vreg<128xf16>
          %v53, %v61 = pto.vldsx2 %ub_b0c_1[%e9_b0c], "DINTLV_B16"
              : !pto.ptr<f16, ub>, index -> !pto.vreg<128xf16>, !pto.vreg<128xf16>
          %v54, %v62 = pto.vldsx2 %ub_b0c_1[%e11_b0c], "DINTLV_B16"
              : !pto.ptr<f16, ub>, index -> !pto.vreg<128xf16>, !pto.vreg<128xf16>
          %v55, %v63 = pto.vldsx2 %ub_b0c_1[%e13_b0c], "DINTLV_B16"
              : !pto.ptr<f16, ub>, index -> !pto.vreg<128xf16>, !pto.vreg<128xf16>
          %v56, %v64 = pto.vldsx2 %ub_b0c_1[%e15_b0c], "DINTLV_B16"
              : !pto.ptr<f16, ub>, index -> !pto.vreg<128xf16>, !pto.vreg<128xf16>
          %v65 = pto.vadd %v49, %v57, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v66 = pto.vadd %v50, %v58, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v67 = pto.vadd %v51, %v59, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v68 = pto.vadd %v52, %v60, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v69 = pto.vadd %v53, %v61, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v70 = pto.vadd %v54, %v62, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v71 = pto.vadd %v55, %v63, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v72 = pto.vadd %v56, %v64, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v73 = pto.vsub %v49, %v57, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v74 = pto.vsub %v50, %v58, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v75 = pto.vsub %v51, %v59, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v76 = pto.vsub %v52, %v60, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v77 = pto.vsub %v53, %v61, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v78 = pto.vsub %v54, %v62, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v79 = pto.vsub %v55, %v63, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          %v80 = pto.vsub %v56, %v64, %mask_b0c : !pto.vreg<128xf16>, !pto.vreg<128xf16>, !pto.mask<b16> -> !pto.vreg<128xf16>
          pto.vsts %v65, %ub_b0c_1[%e1_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          pto.vsts %v66, %ub_b0c_1[%e2_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          pto.vsts %v67, %ub_b0c_1[%e3_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          pto.vsts %v68, %ub_b0c_1[%e4_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          pto.vsts %v69, %ub_b0c_1[%e5_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
          pto.vsts %v70, %ub_b0c_1[%e6_b0c], %mask_b0c {dist = "NORM_B16"} : !pto.vreg<128xf16>, !pto.ptr<f16, ub>, !pto.mask<b16>
