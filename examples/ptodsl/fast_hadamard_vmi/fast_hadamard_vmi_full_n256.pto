    // ---- epilogue: final quad (chunks nchunk-4..nchunk-1), no forward prefetch past end ----
      %coff_b0c = arith.muli %nchunk_m4, %crn_idx : index
      %cbase_b0c = arith.addi %bbase, %coff_b0c : index
